              c.locs.forEach(function(l){
                html += "<li><b>" + l.name + "</b><br>" + l.note + "</li>";
              });
              html += "</ul>";
            } else if(c.story){
              html += "<p>" + c.story + "</p>";
            } else {
              html += "<p>Obec spolupracuje s Agenturou pro sociální začleňování. Konkrétní čtvrť nebo příběh, který by šlo veřejně zdokumentovat, se nám pro tuto obec nepodařilo dohledat — jde tedy jen o obecnou informaci na úrovni celé obce.</p>";
            }
            html += "<p class=\"source-cite\"><b>Zdroj:</b> viz citace v textu; Vláda ČR, Sociální začleňování a bydlení v Ústeckém kraji; Agentura pro sociální začleňování.</p>";
            detail.innerHTML = html;
          });
        });
      }
    })();
    </script>

    <span class="eyebrow" style="margin-top:44px;">Kontext kraje</span>
    <div class="prose">
      <p>Ústecký kraj dlouhodobě vede statistiky sociálního vyloučení v ČR — 89 lokalit podle analýzy z roku 2014 (nárůst z 63 v roce 2006), odhadem 36 000–38 500 obyvatel v těchto lokalitách. Podle Indexu sociálního vyloučení Agentury patří spolu s Moravskoslezským a Karlovarským krajem dlouhodobě mezi tři nejzatíženější kraje v zemi.</p>
      <p>Migrace sociálně slabých obyvatel do kraje (viz kapitola Migrace a nerovnost) a byznys s chudobou vedly k tomu, že se vyloučené lokality objevují i uvnitř jinak funkčních měst — typicky v podobě jednoho nebo více konkrétních sídlišť, ne v celém městě najednou.</p>
    </div>


        Object.keys(kraje).forEach(function(id){
          var el = document.getElementById("kp-" + id);
          if(!el) return;
          el.classList.add("level-" + kraje[id].level);
          el.addEventListener("click", function(){
            document.querySelectorAll(".kraj-path").forEach(function(t){ t.classList.remove("selected"); });
            el.classList.add("selected");
            var k = kraje[id];
            var html = "<h4>" + k.name + "</h4>";
            html += "<span class=\"kd-count\">" + k.count + " lokalit</span>";
            html += "<p>V roce 2006 jich bylo " + k.y06 + " — index růstu " + k.idx + "×. Zdroj: GAC/MPSV, Analýza sociálně vyloučených lokalit v ČR (2015), tabulka 4.1.</p>";
            detail.innerHTML = html;
          });
        });
      }
    })();
    </script>

